name: Daily Python Scraper

# 設定觸發條件：1. 每天早上 8 點自動跑 (UTC 時間 00:00) 2. 也可以手動點擊執行
on:
  schedule:
    - cron: '0 0 * * *'
  workflow_dispatch:

jobs:
  scrape:
    runs-on: ubuntu-latest
    permissions:
      contents: write  # 允許機器人把檔案寫回你的倉庫

    steps:
    - name: 檢查倉庫檔案
      uses: actions/checkout@v4

    - name: 設定 Python 環境
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: 安裝爬蟲需要的套件
      run: |
        pip install requests beautifulsoup4

    - name: 執行 Python 爬蟲
      run: python Scraper.py

    - name: 把抓到的新資料存回 GitHub
      run: |
        git config --local user.email "action@github.com"
        git config --local user.name "GitHub Action"
        git add .
        git diff --quiet && git diff --staged --quiet || (git commit -m "自動更新：抓取最新資料" && git push)
